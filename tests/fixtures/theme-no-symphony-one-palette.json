    "primary": {
     "bg": "$colors.intentPrimary",
     "color": "#fff"
    },
    "success": {
     "bg": "$colors.intentSuccess",
     "color": "#fff"
    },
    "warning": {
     "bg": "$colors.intentWarning",
     "color": "#fff"
    }
   },
   "tooltip": {
    "background": "#C77F40",
    "color": "#fff"
   },
   "topPanel": {
