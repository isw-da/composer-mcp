{
 "name": "synthetic-one-palette",
 "content": {
  "customProperties": {
   "about": {
    "background": "$colors.brandColor",
    "color": "$colors.text",
    "colorSecondary": "$colors.muted",
    "copyright": "$colors.muted"
   },
   "aceEditor": {
    "aceAutocomplete": {
     "background": "$colors.surface",
     "border": "$colors.border",
     "item": {
      "active": {
       "background": "$colors.intentBaseActive",
       "color": "$colors.text"
      },
      "background": "$colors.surface",
      "color": "$colors.text",
      "hover": {
       "background": "rgba(203, 213, 224, 0.4)",
       "color": "$colors.text"
      },
      "matchingValueColor": "$colors.intentPrimary",
      "metaColor": "$colors.muted"
     }
    },
    "codeArea": {
     "activeLine": {
      "background": "$colors.intentBaseDisabled",
      "color": "$colors.text"
     },
     "background": "$colors.surface",
     "border": "$colors.border",
     "color": "$colors.text",
     "gutter": {
      "activeLine": {
       "background": "$colors.backgroundVariant",
       "color": "$colors.text"
      },
      "background": "$colors.intentBaseDisabled",
      "color": "$colors.text"
     }
    }
   },
   "alert": {
    "danger": {
     "color": "$colors.text",
     "iconColor": "$colors.intentDanger",
     "titleColor": "$colors.primary"
    },
    "none": {
     "color": "$colors.text",
     "iconColor": "initial",
     "titleColor": "$colors.primary"
    },
    "primary": {
     "color": "$colors.text",
     "iconColor": "$colors.intentPrimary",
     "titleColor": "$colors.primary"
    },
    "success": {
     "color": "$colors.text",
     "iconColor": "$colors.intentSuccess",
     "titleColor": "$colors.primary"
    },
    "warning": {
     "color": "$colors.text",
     "iconColor": "$colors.intentWarning",
     "titleColor": "$colors.primary"
    }
   },
   "buttons": {
    "base": {
     "active": {
      "bg": "$colors.intentBaseActive"
     },
     "bg": "$colors.intentBase",
     "color": "$colors.text",
     "disabled": {
      "bg": "$colors.intentBaseDisabled"
     },
     "hover": {
      "bg": "$colors.intentBaseHover"
     },
     "iconColor": "$colors.intentMinimal"
    },
    "danger": {
     "active": {
      "bg": "$colors.intentDangerActive"
     },
     "bg": "$colors.intentDanger",
     "color": "$colors.onPrimary",
     "disabled": {
      "bg": "$colors.intentDangerDisabled"
     },
     "hover": {
      "bg": "$colors.intentDangerHover"
     }
    },
    "minimal": {
     "active": {
      "bg": "$colors.intentMinimalActive"
     },
     "bg": "initial",
     "color": "$colors.onSurface",
     "disabled": {
      "color": "$colors.intentMinimalDisabled"
     },
     "hover": {
      "bg": "$colors.intentMinimalHover",
      "iconColor": "$colors.intentMinimal"
     },
     "iconColor": "$colors.intentMinimal"
    },
    "primary": {
     "active": {
      "bg": "$colors.intentPrimaryActive"
     },
     "bg": "$colors.intentPrimary",
     "color": "$colors.onPrimary",
     "disabled": {
      "bg": "$colors.intentPrimaryDisabled"
     },
     "hover": {
      "bg": "$colors.intentPrimaryHover"
     }
    },
    "success": {
     "active": {
      "bg": "$colors.intentSuccessActive"
     },
     "bg": "$colors.intentSuccess",
     "color": "$colors.onPrimary",
     "disabled": {
      "bg": "$colors.intentSuccessDisabled"
     },
     "hover": {
      "bg": "$colors.intentSuccessHover"
     }
    },
    "warning": {
     "active": {
      "bg": "$colors.intentWarningActive"
     },
     "bg": "$colors.intentWarning",
     "color": "$colors.onPrimary",
     "disabled": {
      "bg": "$colors.intentWarningDisabled"
     },
     "hover": {
      "bg": "$colors.intentWarningHover"
     }
    }
   },
   "calculationEditor": {
    "helpPanel": {
     "headerTitle": "$colors.primary",
     "tdTextColor": "$colors.intentMinimal",
     "trBackground": "$colors.surface"
    }
   },
   "callout": {
    "base": {
     "bg": "$colors.backgroundVariant",
     "color": "$colors.onBackgroundVariant"
    },
    "danger": {
     "bg": "$colors.intentDangerBackground",
     "color": "$colors.text"
    },
    "primary": {
     "bg": "$colors.intentPrimaryBackground",
     "color": "$colors.text"
    },
    "success": {
     "bg": "$colors.intentSuccessBackground",
     "color": "$colors.text"
    },
    "warning": {
     "bg": "$colors.intentWarningBackground",
     "color": "$colors.text"
    }
   },
   "card": {
    "background": "$colors.surface",
    "borderColor": "$colors.border"
   },
   "chartLegend": {
    "background": "$colors.background",
    "color": "$colors.text"
   },
   "chartTooltip": {
    "activeColor": "#C77F40",
    "background": "$colors.surface",
    "borderColor": "#2B5096",
    "color": "$colors.text",
    "mutedColor": "#4DCB6A"
   },
   "charts": {
    "ARC": {
     "Label Color": "#C77F40",
     "Label Description Color": "#4DCB6A"
    },
    "BULLET_GAUGE": {
     "Bar Color": "#B25F33",
     "Target Color": "#8F3D29"
    },
    "COMBO_CHART": {
     "Y2 Color": "#746CD4",
     "Y3 Color": "#CC9452",
     "Y4 Color": "#53BFCD"
    },
    "HISTOGRAM": {
     "Bins Color": "#B25F33",
     "Cumulative Line Color": "#746CD4"
    },
    "KPI": {
     "Background Color": "#DF9396",
     "Comparison Data Color": "#4DCB6A",
     "Down Arrow Color": "#746CD4",
     "Label Color": "#A1D673",
     "Metric Color": "#C77F40",
     "Up Arrow Color": "#CC9452",
     "labelEditor": {
      "background": "$colors.backgroundVariant",
      "button": {
       "color": "#C77F40",
       "hover": {
        "background": "rgba(255, 255, 255, 0.7)"
       }
      },
      "input": {
       "background": "$colors.surface",
       "color": "$colors.onSurface"
      }
     }
    },
    "LINE_AND_BARS": {
     "Y1 Color": "#B25F33",
     "Y2 Color": "#746CD4"
    },
    "LINE_CHART": {
     "palette": "DefaultQualitative"
    },
    "SCATTERPLOT": {
     "pointerLabel": {
      "background": "$colors.backgroundVariant",
      "color": "$colors.onBackgroundVariant",
      "shadowColor": "#65BDD2"
     }
    },
    "WATERFALL": {
     "Total Color": "$colors.secondary",
     "palette": "Accent"
    },
    "base": {
     "axisLabelColor": "$colors.text",
     "axisLabelShadow": "rgba(255, 255, 255, 0.0)",
     "axisLineColor": "#65BDD2",
     "backgroundColor": "$colors.surface",
     "color": "$colors.text",
     "palette": "DefaultSequential",
     "pointerColor": "$colors.text",
     "splitLineColor": "$colors.border"
    }
   },
   "checkbox": {
    "background": "$colors.background",
    "border": "$colors.border",
    "checked": {
     "background": "$colors.intentPrimary",
     "border": "$colors.intentPrimary",
     "disabled": {
      "background": "$colors.intentPrimaryDisabled",
      "border": "$colors.intentPrimaryDisabled"
     },
     "innerBackground": "#fff"
    },
    "color": "$colors.text",
    "disabled": {
     "color": "$colors.intentMinimalDisabled"
    }
   },
   "colorPalette": {
    "activeIconColor": "$colors.text",
    "background": "$colors.surface",
    "borderColor": "$colors.border",
    "draggingBackgroundColor": "$colors.background",
    "hover": {
     "background": "$colors.intentBaseHover"
    },
    "iconColor": "$colors.muted",
    "selected": {
     "background": "$colors.intentPrimary"
    }
   },
   "contextMenu": {
    "icon": {
     "rightArrowMargin": "2px 0 0 0"
    },
    "menu": {
     "border": "unset",
     "boxShadow": "0 0 0 1px rgba(13,27,42,0.08), 0 2px 4px rgba(13,27,42,0.12), 0 8px 24px rgba(13,27,42,0.12)",
     "maxHeight": "100%",
     "padding": "5px"
    },
    "menuItem": {
     "alignItems": "flex-start",
     "color": "#C77F40",
     "height": "30px",
     "icon": {
      "margin": "0 10px 0 0"
     },
     "padding": "0 16px"
    },
    "styledMenu": {
     "borderRadius": "4px",
     "maxHeight": "calc(100vh - 10px)",
     "maxWidth": "190px",
     "minWidth": "130px",
     "padding": "5px"
    }
   },
   "createAlertDialog": {
    "summaryPanel": {
     "backgroundColor": "$colors.surface",
     "borderColor": "$colors.border",
     "primaryLine": {
      "color": "$colors.text",
      "fontSize": "$fontSizes[1]"
     },
     "secondaryLine": {
      "color": "$colors.intentMinimal",
      "fontSize": "$fontSizes[0]"
     }
    }
   },
   "crossSourceLinksConfig": {
    "infoMessage": {
     "background": "rgba(8,74,138,0.08)",
     "color": "$colors.text"
    },
    "linksList": {
     "item": {
      "activeBgColor": "$colors.intentPrimary",
      "activeColor": "$colors.onPrimary"
     }
    },
    "sourceListAction": {
     "color": "$colors.linkColor",
     "hover": {
      "color": "$colors.linkColor"
     }
    }
   },
   "crossVisual": {
    "multiSelect": {
     "borderColor": "$colors.border",
     "color": "$colors.onSurface"
    },
    "settings": {
     "borderColor": "$colors.border",
     "secondaryColor": "$colors.muted"
    },
    "visualsList": {
     "item": {
      "activeBgColor": "$colors.intentPrimary",
      "activeColor": "$colors.onPrimary"
     }
    }
   },
   "dashboard": {
    "background": "$colors.background",
    "header": {
     "background": "$colors.surface",
     "controls": {
      "filterActiveIcon": "#CC9452",
      "filterActiveIconHover": "#BB6936",
      "filterIcon": "#4DCB6A",
      "filterIconHover": "#A1D673"
     },
     "text": "$colors.onSurface",
     "unsavedText": "$colors.muted"
    },
    "layout": {
     "widgetGaps": "8px"
    },
    "wrapperBackground": "$colors.background"
   },
   "dashboardList": {
    "background": "$colors.background",
    "linkColor": "$colors.linkColor",
    "preview": {
     "background": "$colors.surface",
     "border": "#2B5096",
     "color": "#A1D673",
     "description": {
      "color": "#4DCB6A"
     },
     "details": {
      "propertyColor": "#4DCB6A",
      "valueColor": "#C77F40"
     },
     "shadow": "rgba(13,27,42,0.12) 2px 2px 10px 0px",
     "title": {
      "background": "#8B7DD9",
      "color": "#A1D673"
     }
    },
    "sidePane": {
     "active": {
      "background": "rgba(8,74,138,0.2)"
     },
     "background": "#C77F40",
     "color": "#2B5096",
     "hover": {
      "background": "rgba(8,74,138,0.12)"
     }
    },
    "topPanel": {
     "background": "rgba(245,247,250, 0.9)",
     "color": "$colors.onBackground"
    }
   },
   "dataDetails": {
    "color": "$colors.text",
    "iconColor": "#4DCB6A",
    "sourceControlsColor": "$colors.intentPrimary",
    "sourceNameColor": "$colors.intentMinimal",
    "titleColor": "$colors.intentMinimal"
   },
   "datePicker": {
    "active": {
     "background": "$colors.intentPrimary",
     "color": "$colors.onPrimary"
    },
    "background": "$colors.surface",
    "color": "$colors.onSurface",
    "divider": {
     "color": "$colors.border"
    },
    "hover": {
     "active": {
      "background": "$colors.intentPrimaryHover",
      "color": "$colors.onPrimary"
     },
     "background": "$colors.intentMinimalHover",
     "color": "$colors.onSurface"
    }
   },
   "dialog": {
    "background": "$colors.background",
    "color": "$colors.onBackgroundVariant",
    "dullColor": "$colors.muted",
    "errorMessage": {
     "background": "$colors.intentDangerBackground",
     "border": "$colors.intentDangerBorder",
     "color": "$colors.message"
    },
    "footerBackground": "$colors.background",
    "footerBorderTop": "1px solid #2B5096",
    "infoMessage": {
     "backgroundError": "$colors.intentDangerBackground",
     "backgroundWarning": "$colors.intentWarningBackground"
    },
    "informationMessage": {
     "background": "$colors.intentInfoBackground",
     "border": "$colors.intentInfoBorder",
     "color": "$colors.message"
    },
    "warningMessage": {
     "background": "$colors.intentWarningBackground",
     "border": "$colors.intentWarningBorder",
     "color": "$colors.message"
    }
   },
   "homePage": {
    "banner": {
     "background": "$colors.brandColor",
     "color": "$colors.onPrimary",
     "mixBlendMode": "lighten"
    },
    "color": "$colors.text",
    "menuCard": {
     "background": "$colors.surface",
     "color": "$colors.onSurface"
    },
    "title": "$colors.muted"
   },
   "icons": {
    "base": {
     "color": "$colors.intentMinimal"
    },
    "danger": {
     "color": "$colors.intentDanger"
    },
    "primary": {
     "color": "$colors.intentPrimary"
    },
    "success": {
     "color": "$colors.intentSuccess"
    },
    "warning": {
     "color": "$colors.intentWarning"
    }
   },
   "input": {
    "background": "$colors.surface",
    "border": "$colors.border",
    "disabled": {
     "background": "$colors.intentBaseDisabled"
    },
    "label": "$colors.text",
    "placeholder": "$colors.muted",
    "text": "$colors.text"
   },
   "list": {
    "bg": "$colors.surface",
    "border": {
     "color": "$colors.intentBaseActive",
     "warningColor": "$colors.intentWarning"
    },
    "item": {
     "active": {
      "bg": "$colors.intentBaseActive",
      "color": "$colors.onSurface"
     },
     "bg": "$colors.surface",
     "color": "$colors.text",
     "hover": {
      "bg": "$colors.intentBase",
      "color": "$colors.onSurface"
     }
    }
   },
   "loader": {
    "background": "rgba(255, 255, 255, 0.8)"
   },
   "menu": {
    "active": {
     "bg": "$colors.intentBaseActive",
     "color": "$colors.text"
    },
    "bg": "$colors.surface",
    "color": "$colors.text",
    "disabled": "$colors.intentMinimalDisabled",
    "divider": {
     "color": "$colors.border",
     "margin": "5px"
    },
    "hover": {
     "bg": "$colors.intentBaseHover",
     "color": "$colors.onSurface"
    },
    "icon": {
     "active": {
      "color": "$colors.intentSuccess",
      "hover": {
