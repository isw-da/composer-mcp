  <script>
  /* ───────────────────────────────────────────────
     Otto Partner Center — native DOM embed
     Uses Composer Trusted Access push tokens + embed.js
     No iframes.
     ─────────────────────────────────────────────── */

  const CONFIG = {
    composerApiUrl: 'https://uat.logi-symphony.com/discovery',
    apiContentType: 'application/vnd.composer.v3+json',
    trustedAccess: {
      // Existing UAT Trusted Access client (same as wizard-demo embed)
      clientId: 'REPLACE_WITH_YOUR_CLIENT_ID',
      secret:   'REPLACE_WITH_YOUR_CLIENT_SECRET',
    },
    sharedUsername: 'amin.hasan',
    account: 'Otto Group',
    group: 'TechWorld GmbH',
    // The 'otto' theme overrides per-visual palette settings, so UBER_BARS bars
    // pick up the inherited modern theme's rainbow palette instead of the Otto
    // red I set on each visual. Falling back to '__platform__' lets the
    // per-visual configs win. Otto branding is enforced via shell CSS.
    theme: '__platform__',
    // Dashboard IDs are stored in URLs as <accountId>_<dashId>;
    // the embed manager wants <accountId>+<dashId>.
    dashboards: {
      snapshot:  '7d498e0c-c75c-4089-b851-b88875b89432+69fba5090b70396702ebb36e',
      campaigns: '7d498e0c-c75c-4089-b851-b88875b89432+69fba50a0b70396702ebb371',
      brands:    '7d498e0c-c75c-4089-b851-b88875b89432+69fba50a0b70396702ebb374',
    },
    // Partner-app-side hover tooltips. Keyed on widget title (case-insensitive
    // substring match). Lets us add real partner-context guidance without
    // touching the Composer dashboards.
    tooltips: {
      'Impressions':         {title: 'Reach',         body: 'How many times your products appeared in front of an Otto shopper. Top-of-funnel volume — read it against Clicks to gauge creative quality.'},
      'Clicks':              {title: 'Engagement',    body: 'Shoppers who clicked an ad through to a product page. Threshold-coloured at 100K and 500K.'},
      'Sales (EUR)':         {title: 'Revenue',       body: 'Gross merchandise value attributed to your campaigns. Includes returns within the attribution window.'},
      'Sales Eur':           {title: 'Revenue',       body: 'Gross merchandise value attributed to your campaigns.'},
      'Ad Spend (EUR)':      {title: 'Cost',          body: 'What you paid Otto for ad placement. Sums all bid types.'},
      'Ad Spend Eur':        {title: 'Cost',          body: 'What you paid Otto for ad placement.'},
      'ROAS':                {title: 'Profitability', body: 'Sales ÷ Ad Spend. Target ≥ 2.5×. Below 1.0× means the campaign is losing money before margin is considered.'},
      'Return on Ad Spend':  {title: 'Profitability', body: 'Sales ÷ Ad Spend. Target ≥ 2.5×.'},
      'Conversion Rate':     {title: 'Funnel health', body: 'Clicks that converted to a sale. Compare across campaign types to find creative that closes.'},
      'Sales vs Ad Spend':   {title: 'Daily trend',   body: 'Bars are revenue, line is spend. When the line outpaces the bars consistently, your unit economics are inverted.'},
      'Campaign Type':       {title: 'Filter',        body: 'Slice every other widget on this tab by campaign type (brand awareness, performance, retargeting, seasonal).'},
      'Top 10 Campaigns by Sales':  {title: 'Where the money came from', body: 'Your highest-revenue campaigns yesterday. Bars are EUR sales, sized largest first.'},
      'Top 10 Campaigns by Clicks': {title: 'Where the traffic came from', body: 'Your highest-traffic campaigns. Useful when paired with the Conversion Rate KPI.'},
      'Top 10 Campaigns by ROAS':   {title: 'Where to invest more',       body: 'Most profitable per ad euro. Bars are sized by sales, coloured by ROAS (red below 1×, green above 2.5×).'},
      'Country x Campaign Type':    {title: 'Geography',     body: 'Sales by country and campaign type. Spot which markets are paying for your ads.'},
      'Partner Segment x Campaign Type': {title: 'Audience', body: 'Clicks by buyer segment. Expand or contract budget per segment based on what converts.'},
      'Country x ROAS by Campaign Type': {title: 'Geographic profitability', body: 'Cell colour shows where you are losing or making money by country and campaign type.'},
      'Brand x Category':           {title: 'Catalogue mix', body: 'Sales broken down by brand and category. Cross-warehouse join: brand attributes from BigQuery, sales facts from Snowflake.'},
      'Brand x Campaign Type':      {title: 'Brand × spend mix', body: 'Where each brand earns its clicks. Find brands carried by performance campaigns vs awareness.'},
      'Price Segment x Campaign Type': {title: 'Price-tier ROAS', body: 'Are premium-priced products paying back more on awareness ads? Use to set tier-specific bid caps.'},
      'View A: Ad clicks':          {title: 'BigQuery raw',   body: 'Direct read from Peter’s OPC View A in BigQuery. Compare to the joined Clicks KPI on tab 1 to validate the semantic layer matches.'},
      'View B: Sales revenue':      {title: 'BigQuery raw',   body: 'Direct read from Peter’s OPC View B in BigQuery.'},
      'View C: Ad-attributed revenue': {title: 'BigQuery raw', body: 'Direct read from Peter’s OPC View C in BigQuery.'},
    },
  };

  const basicAuth = btoa(`${CONFIG.trustedAccess.clientId}:${CONFIG.trustedAccess.secret}`);

  async function getPushToken() {
    const resp = await fetch(`${CONFIG.composerApiUrl}/api/trusted-access/push/tokens`, {
      method: 'POST',
      headers: {
        'Content-Type': CONFIG.apiContentType,
        'Accept': CONFIG.apiContentType,
        'Authorization': `Basic ${basicAuth}`,
      },
      body: JSON.stringify({
        username: CONFIG.sharedUsername,
        account:  CONFIG.account,
        groups:   [CONFIG.group],
      }),
    });
    if (!resp.ok) {
      const txt = await resp.text();
      throw new Error(`push/tokens ${resp.status}: ${txt.slice(0, 400)}`);
    }
    return resp.json();
  }

  function loadEmbedScript() {
    return new Promise((resolve, reject) => {
      if (window.initComposerEmbedManager) return resolve();
      const s = document.createElement('script');
      s.setAttribute('data-name', 'composer-embed-manager');
      s.src = `${CONFIG.composerApiUrl}/embed/embed.js?v=${Date.now()}`;
      s.onload  = () => resolve();
      s.onerror = () => reject(new Error('Failed to load embed.js'));
      document.head.appendChild(s);
    });
  }

  function setStatus(msg)  { document.getElementById('status-msg').textContent = msg; }
  function hideStatus()    { document.getElementById('status').classList.add('hide'); }
  function showError(err) {
    const s = document.getElementById('status');
    s.classList.remove('hide');
    s.innerHTML = `
      <div style="font-weight:600;color:var(--otto-graphite);font-size:15px">Couldn't connect</div>
      <div class="err">${(err && err.message ? err.message : String(err))}</div>
      <div style="font-size:12px;max-width:580px;text-align:center">
        Most common cause: the Trusted Access client isn't scoped to the
        <code>${CONFIG.account}</code> account, or the user
        <code>${CONFIG.sharedUsername}</code> doesn't exist there.
      </div>`;
  }

  // Tab switching
  document.querySelectorAll('nav button').forEach(b => {
    b.addEventListener('click', () => {
      document.querySelectorAll('nav button').forEach(x => x.classList.remove('active'));
      document.querySelectorAll('.pane').forEach(x => x.classList.remove('active'));
      b.classList.add('active');
      document.querySelector(`.pane[data-pane="${b.dataset.target}"]`).classList.add('active');
      // Composer pivot tables lazy-render row bodies based on visibility.
      // Stacked panes (z-index swap) don't fire a viewport change, so nudge
      // a resize after the swap to wake the deferred render path.
      window.dispatchEvent(new Event('resize'));
      setTimeout(() => window.dispatchEvent(new Event('resize')), 60);
    });
  });

  // Embed state — tracked at module scope so the partner switcher can re-render
  // in place without a full page reload.
  const embedState = {
    mgr: null,
    components: {},  // key -> { comp, target }
    currentToken: null,
  };

  async function renderAllDashboards(embedMgr) {
    const tasks = Object.entries(CONFIG.dashboards).map(async ([key, dashboardId]) => {
      const host = document.getElementById(`host-${key}`);
      host.innerHTML = '';
      const target = document.createElement('div');
      target.style.cssText = 'width:100%;height:100%';
      host.appendChild(target);
      const comp = await embedMgr.createComponent('dashboard', {
        originId: '',
        dashboardId,
        interactivityProfileName: 'interactive',
        theme:  CONFIG.theme,
        editor: { placement: 'modals' },
        header: { visible: false, showActions: false, showTitle: false },
      });
      await comp.render(target, { width: '100%', height: '100%' });
      embedState.components[key] = { comp, target };
    });
    await Promise.all(tasks);
  }

  // Boot
  (async () => {
    try {
      setStatus('Requesting embed token…');
      const tok = await getPushToken();
      embedState.currentToken = tok;

      setStatus('Loading Composer embed runtime…');
      await loadEmbedScript();

      setStatus('Initialising embed manager…');
      embedState.mgr = await window.initComposerEmbedManager({
        getToken: async () => ({
          access_token: embedState.currentToken.access_token,
          expires_in:   embedState.currentToken.expires_in || 86399,
        }),
      });

      setStatus('Rendering dashboards…');
      await renderAllDashboards(embedState.mgr);

      hideStatus();
      // Fetch every dashboard's widgets + every visual's `description` so the
      // hover layer below pulls from Composer's native visualDescription field
      // (the "Info > visual description" panel in the Composer UI). Falls back
      // to CONFIG.tooltips for anything Composer doesn't have a description on.
      const descriptions = await loadVisualDescriptions(tok.access_token);
      installTooltipLayer(descriptions);
      installMetricSwitcher();
      installPartnerSwitcher();
      installSavedViews();
      installUsageTab();
    } catch (err) {
      console.error(err);
      showError(err);
    }
  })();

  /* ───────────────────────────────────────────────
     Usage & access tab (UC4).
     Populates the parent-app-rendered Usage pane with a sparkline trend, a
     top-10 most-used reports list, and a segment x category heatmap. Data
     is illustrative for the demo; in production this would proxy
     /api/audit on Composer (gated; not exposed in v25 to tenant admins).
     ─────────────────────────────────────────────── */
  function installUsageTab() {
    // Daily series: 90 days, two metrics (runs + exports). Synthetic but
    // shaped like real usage: weekend dips, end-of-month export spikes.
    const days = 90;
    const series = { runs: [], exports: [] };
    for (let i = 0; i < days; i++) {
      const dow = (i + 4) % 7;  // 0..6, with weekends low
      const weekend = dow === 5 || dow === 6;
      const monthEnd = (i % 30) >= 27;
      const baseRuns = weekend ? 30 : 90;
      const baseExports = monthEnd ? 14 : 4;
      const noise = (n) => Math.max(0, Math.round(n + (Math.random() - 0.5) * n * 0.4));
      series.runs.push(noise(baseRuns));
      series.exports.push(noise(baseExports));
    }

    // Render SVG trend
    const svg = document.getElementById('usage-trend');
    if (svg) {
      const W = 880, H = 200, P = 20;
      const maxRuns = Math.max(...series.runs);
      const maxExports = Math.max(...series.exports);
      function bars() {
        const out = [];
        const bw = (W - P*2) / days - 1;
        series.runs.forEach((v, i) => {
          const h = (v / maxRuns) * (H - P*2);
          const x = P + i * ((W - P*2) / days);
          const y = H - P - h;
          out.push(`<rect x="${x.toFixed(1)}" y="${y.toFixed(1)}" width="${bw.toFixed(1)}" height="${h.toFixed(1)}" fill="#E2001A" opacity="0.85"/>`);
        });
        return out.join('');
      }
      function line(values, max, color) {
        const pts = values.map((v, i) => {
          const x = P + i * ((W - P*2) / days) + ((W - P*2) / days)/2;
          const y = H - P - (v / max) * (H - P*2);
          return `${x.toFixed(1)},${y.toFixed(1)}`;
        }).join(' ');
        return `<polyline points="${pts}" fill="none" stroke="${color}" stroke-width="1.8"/>`;
      }
      svg.innerHTML = bars() + line(series.exports, maxExports, '#1A1A1A');
    }

    // Top 10 most-used reports
    const reports = [
      ['Yesterday at a glance', 1842],
      ['Where to redirect spend', 1456],
      ['Brand & category mix', 987],
      ['Top 10 campaigns by ROAS', 743],
      ['Country x ROAS by Campaign Type', 612],
      ['Partner Segment x Campaign Type', 489],
      ['Brand x Category (Sales)', 384],
      ['Top 10 campaigns by Sales', 312],
      ['Price Segment x Campaign Type (ROAS)', 256],
      ['Daily activity', 187],
    ];
    const list = document.getElementById('usage-top-list');
    if (list) {
      const max = Math.max(...reports.map(r => r[1]));
      list.innerHTML = reports.map(([name, runs], i) => {
        const pct = Math.round((runs / max) * 100);
        return `<li>
          <span class="rank">${i + 1}.</span>
          <span class="name">${name}<div class="bar"><div class="bar-fill" style="width:${pct}%"></div></div></span>
          <span class="runs">${runs.toLocaleString()}</span>
        </li>`;
      }).join('');
    }

    // Segment x category heatmap
    const segments = ['Small', 'Medium', 'Large', 'Strategic'];
    const categories = ['brand_awareness', 'performance', 'retargeting', 'seasonal'];
    const grid = [
      [142, 487, 312, 198],
      [231, 856, 542, 376],
      [389, 1247, 721, 504],
      [108, 397, 198, 156],
    ];
    const tbl = document.getElementById('usage-segment-table');
    if (tbl) {
      const flat = grid.flat();
      const maxV = Math.max(...flat);
      const heat = (v) => {
        const t = v / maxV;
        // Otto red gradient: light pink -> red
        const r = 252 - Math.round((252 - 226) * t);
        const g = 226 - Math.round((226 - 0) * t);
        const b = 229 - Math.round((229 - 26) * t);
        return `rgb(${r},${g},${b})`;
      };
      const headerCells = '<th>Segment \\ Report category</th>' + categories.map(c => `<th>${c}</th>`).join('') + '<th>Total</th>';
      const bodyRows = segments.map((seg, i) => {
        const row = grid[i];
        const total = row.reduce((a, b) => a + b, 0);
        const cells = row.map(v => `<td class="heat" style="background:${heat(v)}">${v.toLocaleString()}</td>`).join('');
        return `<tr><td>${seg}</td>${cells}<td><b>${total.toLocaleString()}</b></td></tr>`;
      }).join('');
      tbl.innerHTML = `<thead><tr>${headerCells}</tr></thead><tbody>${bodyRows}</tbody>`;
    }
  }

  /* ───────────────────────────────────────────────
     Saved views — left-side drawer.
     v25 of Composer doesn't expose a bookmarks/saved-views API (six
     candidate endpoints all 404). So we store user state at the parent-
     app layer in localStorage, scoped per username. A saved view captures:
       { name, tab, partner, metric, savedAt }
     Click to restore replays the captured state through the existing UI
     controls (nav button click, partner select change, metric chip click)
     so all the side effects (re-mint, re-render, attribute toggle) fire
     without duplicating logic.
     ─────────────────────────────────────────────── */
  function installSavedViews() {
    const STORAGE_KEY = 'otto-saved-views:' + (CONFIG.sharedUsername || 'anonymous');
    const toggle = document.getElementById('views-toggle');
    const drawer = document.getElementById('views-drawer');
    const backdrop = document.getElementById('views-backdrop');
    const closeBtn = document.getElementById('views-close');
    const saveBtn = document.getElementById('views-save');
    const list = document.getElementById('views-list');
    const empty = document.getElementById('views-empty');

    function load() {
      try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]'); }
      catch { return []; }
    }
    function save(views) {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(views));
    }
    function open() {
      drawer.classList.add('open'); drawer.setAttribute('aria-hidden', 'false');
      backdrop.classList.add('open');
      render();
    }
    function close() {
      drawer.classList.remove('open'); drawer.setAttribute('aria-hidden', 'true');
      backdrop.classList.remove('open');
    }

    function captureState() {
      const activeNav = document.querySelector('nav button.active');
      const tab = activeNav ? activeNav.dataset.target : 'snapshot';
      const partnerSel = document.getElementById('partner-select');
      const partner = partnerSel ? partnerSel.value : CONFIG.group;
      const activeChip = document.querySelector('.metric-chip.active');
      const metric = activeChip ? activeChip.dataset.metric : 'sales';
      return { tab, partner, metric };
    }

    async function restoreState(state) {
      // 1) Switch tab
      const navBtn = document.querySelector(`nav button[data-target="${state.tab}"]`);
      if (navBtn) navBtn.click();
      // 2) Switch partner if different (this re-mints + re-renders)
      const partnerSel = document.getElementById('partner-select');
      if (partnerSel && partnerSel.value !== state.partner) {
        partnerSel.value = state.partner;
        partnerSel.dispatchEvent(new Event('change'));
      }
      // 3) Switch metric chip on Tab 2
      const targetChip = document.querySelector(`.metric-chip[data-metric="${state.metric}"]`);
      if (targetChip && !targetChip.classList.contains('active')) targetChip.click();
    }

    function render() {
      const views = load();
      list.innerHTML = '';
      if (views.length === 0) {
        empty.classList.remove('hidden');
      } else {
        empty.classList.add('hidden');
        views.forEach((v, i) => {
          const li = document.createElement('li');
          const dt = new Date(v.savedAt);
          const dtStr = dt.toLocaleDateString(undefined, {month: 'short', day: 'numeric'});
          li.innerHTML = `<span class="name"></span><span class="meta"></span><button class="delete" title="Delete view">&times;</button>`;
          li.querySelector('.name').textContent = v.name;
          li.querySelector('.meta').textContent = dtStr;
          li.addEventListener('click', (e) => {
            if (e.target.closest('.delete')) return;
            restoreState(v); close();
          });
          li.querySelector('.delete').addEventListener('click', (e) => {
            e.stopPropagation();
            const fresh = load();
            fresh.splice(i, 1);
            save(fresh);
            render();
          });
          list.appendChild(li);
        });
      }
    }

    toggle.addEventListener('click', open);
    closeBtn.addEventListener('click', close);
    backdrop.addEventListener('click', close);
    saveBtn.addEventListener('click', () => {
      const state = captureState();
      const defaultName = `${state.partner.split(' ')[0]} – ${state.tab} (${state.metric})`;
      const name = window.prompt('Name this view', defaultName);
      if (!name) return;
      const fresh = load();
      fresh.unshift({ ...state, name, savedAt: Date.now() });
      save(fresh.slice(0, 12));
      render();
    });

    // Initial render so the count is right when the drawer opens
    render();
  }

  /* ───────────────────────────────────────────────
     Partner switcher — top-right header.
     Demonstrates the "app-level interactivity" Peter calls out as the
     differentiator vs iframe-only embedding. The parent app changes the
     end-user identity (the `groups` claim on the push token) and the embed
     re-renders in place. Same dashboards, different scope.

     Composer's Trusted Access push tokens carry a `groups` array which is
     applied as a forced filter at query time. So switching from
     "TechWorld GmbH" to "HomeBasics AG" re-runs every visual's query
     against the new partner's slice of data — without leaving the page,
     without re-loading the embed runtime, without changing dashboards.
     ─────────────────────────────────────────────── */
  async function installPartnerSwitcher() {
    const sel = document.getElementById('partner-select');
    const wrap = sel?.closest('.partner-tag-wrap');
    if (!sel || !wrap) return;
    sel.addEventListener('change', async () => {
      const newGroup = sel.value;
      wrap.classList.add('refreshing');
      try {
        // Re-mint a push token with the new partner's group claim
        CONFIG.group = newGroup;
        const newTok = await getPushToken();
        embedState.currentToken = newTok;

        // Tear down + re-render every embed component so each visual re-queries
        // with the new forced-filter scope from the token's groups claim.
        for (const k of Object.keys(embedState.components)) {
          try { embedState.components[k].comp.destroy(); } catch (_) {}
        }
        embedState.components = {};
        await renderAllDashboards(embedState.mgr);

        // Re-tag widgets for the metric switcher (Tab 2 widgets are recreated)
        installMetricSwitcher();
      } catch (e) {
        console.error('partner switch failed', e);
        // Roll back the select if it broke
        sel.value = CONFIG.group;
      } finally {
        wrap.classList.remove('refreshing');
      }
    });
  }

  /* ───────────────────────────────────────────────
     Metric switcher — Tab 2.
     Replaces the previous three side-by-side Top-N visuals with a chip
     control above the embed: one click swaps which metric drives the
     visible Top-N. Composer's native left-rail metric picker is a
     standalone-mode feature, so we drive the swap from the parent app.

     The implementation tags each Composer-rendered widget wrapper with a
     `data-metric` attribute by matching the widget title text to one of
     {sales, clicks, roas}. CSS rules above (`.pane[data-pane=...][data-metric=...]`)
     then hide the two non-active widgets while keeping the active one
     visible at full width.
     ─────────────────────────────────────────────── */
  function installMetricSwitcher() {
    const pane = document.querySelector('.pane[data-pane="campaigns"]');
    if (!pane) return;

    function tagWidgets() {
      const items = pane.querySelectorAll('[class*="zd-grid-item"]');
      let tagged = 0;
      items.forEach(item => {
        const txt = (item.textContent || '').slice(0, 80);
        let metric = null;
        if (/Top 10 Campaigns by Sales/i.test(txt))  metric = 'sales';
        else if (/Top 10 Campaigns by Clicks/i.test(txt)) metric = 'clicks';
        else if (/Top 10 Campaigns by ROAS/i.test(txt))   metric = 'roas';
        if (metric) {
          // data-widget-metric (not data-metric) so the CSS selector that
          // hides inactive widgets doesn't accidentally also hide the chips
          item.setAttribute('data-widget-metric', metric);
          tagged++;
        }
      });
      return tagged;
    }

    // Default to sales
    pane.setAttribute('data-metric', 'sales');

    // Composer renders widgets async after the embed initialises. Poll for a
    // few seconds until all three Top-N wrappers are tagged.
    let attempts = 0;
    const intv = setInterval(() => {
      const found = tagWidgets();
      if (found >= 3 || ++attempts > 30) clearInterval(intv);
    }, 250);

    // Wire chip click handler
    pane.querySelectorAll('.metric-chip').forEach(chip => {
      chip.addEventListener('click', () => {
        const m = chip.getAttribute('data-metric');
        pane.setAttribute('data-metric', m);
        pane.querySelectorAll('.metric-chip').forEach(c => c.classList.toggle('active', c === chip));
        // Re-tag widgets in case Composer re-rendered them since last
        tagWidgets();
        // Also nudge a resize so the now-visible widget reflows to full width
        window.dispatchEvent(new Event('resize'));
      });
    });
  }

  /* ───────────────────────────────────────────────
     Visual description loader.
     For every dashboard we embed, fetch its widgets, then fetch each widget's
     visual to read Composer's native `description` field (the "Info > Visual
     description" panel in Composer's UI). Cache by widget name so the hover
     layer can look up partner-voice copy without bundling it client-side.
     This is what we say to Otto when they ask how the tooltips work — it's
     a real product feature, the description lives on the visual record on
     the server, exposed via the standard REST API.
     ─────────────────────────────────────────────── */
  async function loadVisualDescriptions(accessToken) {
    const map = {};  // widgetName -> description string
    const H = {
      'Accept': CONFIG.apiContentType,
      'Authorization': 'Bearer ' + accessToken,
    };
    try {
      for (const [, fullDashId] of Object.entries(CONFIG.dashboards)) {
        const dashId = fullDashId.split('+')[1] || fullDashId;
        const d = await fetch(`${CONFIG.composerApiUrl}/api/dashboards/${dashId}`, {headers: H}).then(r => r.json());
        for (const w of (d.widgets || [])) {
          const vid = w.visualId || (w.content && w.content.visualId);
          if (!vid) continue;
          const v = await fetch(`${CONFIG.composerApiUrl}/api/visuals/${vid}`, {headers: H}).then(r => r.json());
          if (v.description) map[w.name] = v.description;
        }
      }
    } catch (e) {
      console.warn('visualDescription load failed, falling back to CONFIG.tooltips', e);
    }
    return map;
  }

  /* ───────────────────────────────────────────────
     Hover tooltip layer.
     Looks up Composer's native visualDescription first, falls back to the
     CONFIG.tooltips copy for any widget the API didn't return a description
     for. The fallback exists so a fresh dashboard with no descriptions still
     gets sensible tooltips during demo prep.
     ─────────────────────────────────────────────── */
  function installTooltipLayer(visualDescriptions = {}) {
    const tip = document.getElementById('otto-tip');
    let activeFor = null;

    function findHint(text) {
      if (!text) return null;
      const t = text.trim();
      // Try the live Composer description first (exact then longest substring)
      if (visualDescriptions[t]) {
        return {title: t, body: visualDescriptions[t], source: 'composer'};
      }
      const liveKeys = Object.keys(visualDescriptions).sort((a, b) => b.length - a.length);
      for (const k of liveKeys) {
        if (t.indexOf(k) !== -1) {
          return {title: k, body: visualDescriptions[k], source: 'composer'};
        }
      }
      // Fall back to bundled copy
      if (CONFIG.tooltips[t]) return CONFIG.tooltips[t];
      const keys = Object.keys(CONFIG.tooltips).sort((a, b) => b.length - a.length);
      for (const k of keys) {
        if (t.indexOf(k) !== -1) return CONFIG.tooltips[k];
      }
      return null;
    }

    function showTip(target, hint) {
      if (activeFor === target) return;
      activeFor = target;
      tip.innerHTML = `<div class="tip-title">${hint.title}</div>${hint.body}`;
      const r = target.getBoundingClientRect();
      const tipW = 320;
      let left = r.left;
      if (left + tipW > window.innerWidth - 12) left = window.innerWidth - tipW - 12;
      let top = r.bottom + 6;
      // If tooltip would overflow viewport bottom, flip above
      if (top + 120 > window.innerHeight - 12) top = r.top - 120 - 6;
      tip.style.left = left + 'px';
      tip.style.top = top + 'px';
      tip.classList.add('show');
      tip.setAttribute('aria-hidden', 'false');
    }
    function hideTip() {
      activeFor = null;
      tip.classList.remove('show');
      tip.setAttribute('aria-hidden', 'true');
    }

    // Composer renders widget titles inside elements that contain a child with
    // class `widget-title` (or similar). Hover-detect via mouseover bubbling.
    document.addEventListener('mouseover', (e) => {
      // Walk up to find the widget-body that contains a widget title
      let el = e.target;
      let hops = 0;
      while (el && hops < 8) {
        if (el.classList && (el.classList.contains('widgetBody') || el.classList.contains('widget-title') || el.classList.contains('widgetHeader') || el.classList.contains('zdView-Widget'))) {
          // Find the title text
          const titleEl = el.querySelector('.widget-title, [class*="WidgetTitle"], [class*="widgetTitle"], header span') || el;
          const text = (titleEl.textContent || '').slice(0, 80);
          const hint = findHint(text);
          if (hint) { showTip(el, hint); return; }
        }
        el = el.parentElement;
        hops++;
      }
      // No widget under cursor — hide
      if (activeFor && !activeFor.contains(e.target)) hideTip();
    }, true);
    document.addEventListener('mouseleave', hideTip, true);
  }
  </script>
</body>
</html>
